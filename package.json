{
  "name": "jakarta-apartment-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive Jakarta apartment monitor for Monas workers, prioritizing MRT/LRT and 1-2BR units under IDR 900m.",
  "scripts": {
    "monitor": "node scripts/monitor.mjs",
    "validate": "node scripts/validate.mjs",
    "set:runtime": "node scripts/set-runtime-config.mjs",
    "dev": "npx --yes serve -l 3000 .",
    "deploy": "npx --yes vercel --prod --yes",
    "codex:deploy": "bash scripts/codex-deploy.sh"
  },
  "dependencies": {},
  "engines": {
    "node": ">=20"
  }
}
